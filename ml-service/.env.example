# ML service environment: development | test | production
ML_ENVIRONMENT=development

# Path to the offline-trained Random Forest Joblib artifact
ML_MODEL_PATH=models/ember_rf.joblib

# Official EMBER 2018 extracted dataset directory (not committed to Git)
ML_EMBER_DATA_DIR=data/ember2018

# Maximum PE upload size (50 MB). Matches the CipherGuard AI analysis target.
ML_MAX_FILE_SIZE_BYTES=52428800

# Bind address used by local uvicorn runs (optional)
ML_HOST=127.0.0.1
ML_PORT=8000
