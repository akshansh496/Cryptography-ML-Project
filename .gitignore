# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Environment variables and secrets (CRITICAL SECURITY: Never commit private keys or secrets)
.env
.env.*
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.pk8
private_key.pem
secrets/
id_rsa*

# Model artifacts and datasets
*.joblib
*.pkl
*.pickle
ml-service/data/*
ml-service/models/*
!ml-service/data/.gitkeep
!ml-service/models/.gitkeep

# Build artifacts
dist/
build/
*.tsbuildinfo

# Storage Directories (CRITICAL SECURITY: Never commit encrypted blobs or temporary files)
storage/encrypted/*
!storage/encrypted/.gitkeep
storage/temp/*
!storage/temp/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep
backend/storage/encrypted/*
!backend/storage/encrypted/.gitkeep
backend/storage/temp/*
!backend/storage/temp/.gitkeep
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep

# Testing and coverage
coverage/
.nyc_output/

# OS and IDE files
.DS_Store
.AppleDouble
._*
Thumbs.db
.vscode/
.idea/
*.log

# Local documentation / PDFs (protect uncommitted user docs)
*.pdf
