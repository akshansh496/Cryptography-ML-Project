# ==============================================================================
# CipherGuard AI - Backend Environment Configuration Example
# Copy this file to .env and change the secrets
# ==============================================================================

# Server configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database (matches docker-compose.yml)
DATABASE_URL="postgresql://cipherguard:cipherguard@localhost:5432/cipherguard?schema=public"

# JWT Authentication secrets (use long random strings)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Frontend origin allowed by CORS (Vite default)
FRONTEND_ORIGIN=http://localhost:5173

# ML Service: "mock" until Member 1's FastAPI is ready, then "real"
ML_MODE=mock
ML_SERVICE_URL=http://localhost:8000

# File Storage Directory
STORAGE_DIR=./storage

# Risk Thresholds (BR-3): 0-30 Low, 31-70 Medium, 71-100 High
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70

# ==============================================================================
# Cryptography & Secure Storage Configuration (Member 3)
# ==============================================================================

# Dedicated Storage Locations
CIPHERGUARD_STORAGE_ROOT="./storage"
CIPHERGUARD_ENCRYPTED_STORAGE_DIR="./storage/encrypted"
CIPHERGUARD_TEMP_STORAGE_DIR="./storage/temp"

# RSA-OAEP Key Management for Envelope Encryption
# In development: either specify paths to PEM files or allow ephemeral keys.
# In production: provide CIPHERGUARD_RSA_PUBLIC_KEY and CIPHERGUARD_RSA_PRIVATE_KEY
CIPHERGUARD_RSA_PUBLIC_KEY_PATH="./secrets/rsa_public.pem"
CIPHERGUARD_RSA_PRIVATE_KEY_PATH="./secrets/rsa_private.pem"

# In dev/test only, set to 'true' to allow generating ephemeral keys in-memory if no key is configured
CIPHERGUARD_ALLOW_DEV_KEYS="true"
